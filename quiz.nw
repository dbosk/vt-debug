def test_every_stage_gets_a_suggestion_from_its_own_register():
    with tempfile.TemporaryDirectory() as directory:
        write_export(directory, "grundskola-2020.csv", GRUNDSKOLA)
        write_export(directory, "gymnasieskola-2023.csv", GYMNASIESKOLA)
        registers = load_registers(directory)
        row = {"School: lågstadiet": "Lendahlsskolan, Ale",
               "School: mellanstadiet": "Vasaskolan, Hedemora",
               "School: högstadiet": "",
               "School: gymnasiet": "Fria gymnasiet, Gävle"}
        outcomes, unmatched = fill_sheet([row], registers)
    assert row["suggested_huvudman: lågstadiet"] == "kommunal"
    assert row["suggested_huvudman: mellanstadiet"] == "enskild"
    assert row["suggested_huvudman: högstadiet"] == UNKNOWN
    assert row["suggested_huvudman: gymnasiet"] == "enskild"
    assert outcomes[("gymnasiet", "matched")] == 1
    assert not unmatched
