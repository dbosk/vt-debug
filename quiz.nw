<<item: consent>>,
<<item: previous programming>>,
<<item: how learned>>,
<<item: confidence>>,
<<item: debugging exercise>>,
<<item: school in years 1-3>>,
<<item: school in years 4-6>>,
<<item: school in years 7-9>>,
<<item: upper secondary school>>,
<<item: upper secondary programme>>,
<<item: preparatory year>>
@

