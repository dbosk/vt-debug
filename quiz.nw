class FakeUser:
    """A roster entry with the attributes the lookup reads."""

    def __init__(self, user_id, name, login_id, sis_user_id=None):
        self.id = user_id
        self.name = name
        self.login_id = login_id
        self.sis_user_id = sis_user_id


class FakeCourse:
    """A course whose roster is a fixed list of users."""

    def __init__(self, users):
        self.users = users

    def get_users(self, **kwargs):
        return self.users


NAMESAKES = FakeCourse([
    FakeUser(1, "Ann Andersson", "ann@kth.se", sis_user_id="a1"),
    FakeUser(2, "Ann Andersson", "anna@kth.se", sis_user_id="a2"),
])
