def report_of(students, bodies=REPORT_BODIES):
    """Return a report-shaped CSV of these student rows."""
    header = REPORT_STUDENT_COLUMNS + "".join(
        f",ItemID,ItemType,{body},EarnedPoints,Status" for body in bodies
    )
