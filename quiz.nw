The main function ties the pieces together: fetch (or read) the
report, tabulate and summarise, and---for the background quiz, whose
open items are the ones that get coded---pre-code if asked to and write
the sheet.

<<analysis main>>=
def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--quiz", choices=QUIZ_TITLES, default="background",
                        help="which quiz to analyse")
    parser.add_argument("--results",
                        help="read this CSV instead of fetching from Canvas")
    parser.add_argument("--llm", action="store_true",
                        help="pre-code the open answers with an LLM")
    parser.add_argument("--coding-sheet", default="quiz-coding-sheet.csv",
                        help="output CSV for the coding of open answers")
    args = parser.parse_args()

    if args.results:
        with open(args.results, newline="") as infile:
            rows = list(csv.DictReader(infile))
    else:
        rows = fetch_results(args.quiz)
    if not rows:
        sys.exit("no responses")

    print(f"{len(rows)} students")
    for item in CLOSED_ITEMS:
        tabulate(rows, item)
    summarize_scores(rows)
    if args.quiz == "background":
        suggestions = llm_precode(rows) if args.llm else None
        write_coding_sheet(rows, args.coding_sheet, suggestions)
        print(f"\ncoding sheet written to {args.coding_sheet}")
